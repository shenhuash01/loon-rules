#!name=Keep去广告
#!desc=Keep 应用净化：去开屏广告、弹窗、信息流广告（规则改编自墨鱼 ddgksf2013）
#!author=shenhuash01
#!homepage=https://github.com/shenhuash01/loon-rules

[Rewrite]
# 屏蔽应用内弹窗
^https?:\/\/api\.gotokeep\.com\/guide-webapp\/v\d\/popup\/getPopUp url reject-200
^https?:\/\/api\.gotokeep\.com\/running\/v\d\/home\/dialog url reject-200
# 屏蔽部分启动弹窗
^https?:\/\/api\.gotokeep\.com\/kprime\/v\d\/popups\/primeGuide url reject-200
# 屏蔽开屏广告请求
^https?:\/\/hc-ssp\.sm\.cn url reject-200
^https?:\/\/kad\.gotokeep\.com\/op-engine-webapp\/v\d\/ad url reject-200
# 屏蔽青少年弹窗
^https?:\/\/api.gotokeep.com/cauchy/growth/init url reject-200
# 屏蔽搜索栏自动填充词/热词
^https?:\/\/api\.gotokeep\.com\/search\/v\d\/default\/keyword\/list url reject-200
^https?:\/\/api\.gotokeep\.com\/search\/v\d\/hotword\/list url reject-200
^https?:\/\/api\.gotokeep\.com\/search\/v\d\/hotHashtag\/list url reject-200
^https?:\/\/api\.gotokeep\.com\/search\/v\d\/hotCourse\/list url reject-200
# 屏蔽adwebapp
^https?:\/\/api\.gotokeep\.com\/op-engine-webapp\/v\d\/ad url reject-200
# 屏蔽广告预加载
^https?:\/\/api\.gotokeep\.com\/ads\/v\d\/ads\/preload url reject-200
# 屏蔽adbox
^https?:\/\/api\.gotokeep\.com\/training\/box\/config url reject-200
# 屏蔽更新检查
^https?:\/\/api\.gotokeep\.com\/anno\/v\d\/upgrade\/check url reject-200

[Script]
keep-my-page = type=http-response, pattern=^https?:\/\/api\.gotokeep\.com\/athena\/v\d\/people\/my$, requires-body=1, script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/keepStyle.js, timeout=10
keep-tabbar = type=http-response, pattern=^https?:\/\/api\.gotokeep\.com\/config\/v\d\/basic, requires-body=1, script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/keepStyle.js, timeout=10
keep-feed = type=http-response, pattern=^https?:\/\/api\.gotokeep\.com\/twins\/v4\/feed\/course, requires-body=1, script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/keepStyle.js, timeout=10

[MitM]
hostname = hc-ssp.sm.cn, api.gotokeep.com, kad.gotokeep.com
